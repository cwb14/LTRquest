/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    cwb14/LTRquest Nextflow config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // Input / output
    input                      = null
    outdir                     = null
    publish_dir_mode           = 'copy'

    // Detection
    max_rounds                 = 10
    terminate_count            = 100
    fp_mask_threshold          = 0.10
    family_prefix              = 'merged'
    skip_plots                 = false

    // AWS Batch (see conf/awsbatch.config)
    aws_queue                  = 'ltrquest-queue'
    aws_region                 = 'us-east-1'

    help                       = false
    version                    = false
}

// Ceiling for what any one task may request. A process asking for more is
// clamped rather than failing to schedule, so a pipeline written for a big node
// still runs on a laptop -- just slower. Literal values, not params: the params
// block is resolved before profiles are merged, so a `--max_cpus` knob would
// silently keep its default whenever a profile tried to lower it. Override with
// your own `-c site.config`; conf/test.config does exactly that.
process {
    resourceLimits = [ cpus: 16, memory: '128.GB', time: '48.h' ]
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    debug {
        dumpHashes             = true
        cleanup                = false
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        conda.enabled          = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        docker.enabled         = false
        conda.enabled          = false
    }
    conda {
        conda.enabled          = true
        conda.channels         = ['conda-forge', 'bioconda']
        docker.enabled         = false
        singularity.enabled    = false
    }
    awsbatch  { includeConfig 'conf/awsbatch.config'  }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}

// Containers ship their own toolchain; keep the host's site-packages out.
env {
    PYTHONNOUSERSITE = 1
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt"     }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html"      }

manifest {
    name            = 'cwb14/LTRquest'
    author          = 'Chris Benson'
    homePage        = 'https://github.com/cwb14/LTRquest'
    description     = 'Iterative detection of nested LTR retrotransposons'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0'
}
