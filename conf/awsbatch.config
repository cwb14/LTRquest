/*
    AWS Batch.

        nextflow run cwb14/LTRquest -profile awsbatch \
            --input      s3://my-bucket/samplesheet.csv \
            --outdir     s3://my-bucket/results \
            --aws_queue  my-batch-queue \
            --aws_region us-east-1 \
            -work-dir    s3://my-bucket/work

    Credentials come from the usual chain: AWS_ACCESS_KEY_ID /
    AWS_SECRET_ACCESS_KEY, ~/.aws/credentials, or an attached instance role.
    The Batch compute environment needs an AMI with Docker and enough instance
    storage to hold a genome plus its suffix array.
*/

params {
    config_profile_name        = 'AWS Batch'
    config_profile_description = 'Run on AWS Batch against an S3 work directory'
}

process {
    executor      = 'awsbatch'
    queue         = params.aws_queue
    // 4 is Batch's own "host terminated the task" code; worth one more try on a
    // different spot instance.
    errorStrategy = { task.exitStatus in ((130..145) + [104, 4]) ? 'retry' : 'finish' }
    maxRetries    = 3
}

aws {
    region = params.aws_region
    batch {
        // Batch stages S3 inputs using the AWS CLI *inside* the container; the
        // LTRquest image installs it at this path.
        cliPath              = '/opt/conda/bin/aws'
        maxParallelTransfers = 8
        maxTransferAttempts  = 3
        volumes              = '/tmp'
    }
    client {
        uploadChunkSize = 10485760
        maxConnections  = 20
    }
}

docker.enabled      = true
singularity.enabled = false
conda.enabled       = false

// S3 has no symlinks, so publishing must copy.
params.publish_dir_mode = 'copy'
