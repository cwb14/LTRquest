/*
    Minimal smoke test.

    Sized for `-stub-run` in CI: the stub blocks emit a handful of fake records,
    so the whole DAG -- including the round chain and its termination gate --
    is exercised without GenomeTools, MMseqs2 or any other external tool.

        nextflow run . -profile test -stub-run --outdir results

    Drop -stub-run (and add -profile test,docker) to run it for real.
*/

process {
    resourceLimits = [ cpus: 2, memory: '6.GB', time: '1.h' ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal dataset to check the pipeline wiring'

    input                      = "${projectDir}/assets/samplesheet_test.csv"
    outdir                     = 'results_test'

    // Three rounds is enough to see the chain advance and then stop: the stub
    // detector returns 2 elements in round 1, 1 in round 2 and none after, so
    // with terminate_count = 1 the loop halts on its own at round 3.
    max_rounds                 = 3
    terminate_count            = 1
    family_prefix              = 'test'
}
