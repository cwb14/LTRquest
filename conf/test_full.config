/*
    Full-size test: the real Arabidopsis chr2 that ships with the repo, all
    rounds, real tools. Minutes, not seconds.

        nextflow run . -profile test_full,docker --outdir results
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Arabidopsis thaliana chr2, full nested search'

    input                      = "${projectDir}/assets/samplesheet_full.csv"
    outdir                     = 'results_full'
    max_rounds                 = 10
    terminate_count            = 100
    family_prefix              = 'athal'
}
