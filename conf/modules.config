/*
    Per-process publishing and extra arguments.

    Only the reconciled, family-annotated set is published by default. The raw
    per-round tables and .work directories stay in the Nextflow work directory:
    they are large, they are intermediates, and -resume can regenerate anything
    downstream from them.
*/

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'LTRQUEST_DETECT' {
        publishDir = [ enabled: false ]
    }

    withName: 'LTRQUEST_MASK' {
        publishDir = [ enabled: false ]
    }

    withName: 'LTRQUEST_RECONCILE' {
        publishDir = [ enabled: false ]
    }

    withName: 'LTRQUEST_CLUSTER' {
        publishDir = [
            path: { "${params.outdir}/families" },
            mode: params.publish_dir_mode,
            pattern: '*_cluster.tsv'
        ]
    }

    withName: 'LTRQUEST_FLAGFP' {
        publishDir = [
            path: { "${params.outdir}/families" },
            mode: params.publish_dir_mode,
            pattern: '*_fpcheck.log'
        ]
    }

    withName: 'LTRQUEST_ANNOTATE' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*_depth*_ltr.tsv'
        ]
    }

    withName: 'LTRQUEST_GFF3' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.gff3'
        ]
    }

    withName: 'LTRQUEST_PLOTS' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*_plots'
        ]
    }
}
